CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MINIDASH_DISPLAY_ENABLE=y
CONFIG_MINIDASH_LCD_CONTROLLER_ST7789=y
CONFIG_MINIDASH_DISPLAY_SMOKE_TEST=n
CONFIG_MINIDASH_DISPLAY_ROTATION=2
CONFIG_MINIDASH_LCD_PIN_SCLK=12
CONFIG_MINIDASH_LCD_PIN_MOSI=11
CONFIG_MINIDASH_LCD_PIN_MISO=13
CONFIG_MINIDASH_LCD_PIN_CS=10
CONFIG_MINIDASH_LCD_PIN_DC=8
CONFIG_MINIDASH_LCD_PIN_RST=9
CONFIG_MINIDASH_LCD_PIN_BL=-1
CONFIG_MINIDASH_TOUCH_ENABLE=y
CONFIG_MINIDASH_TOUCH_PIN_CS=14
