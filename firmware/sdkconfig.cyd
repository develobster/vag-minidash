# Independent 4 MB / no PSRAM profile; never layer S3 defaults onto this file.
CONFIG_IDF_TARGET="esp32"
CONFIG_MINIDASH_CYD=y
CONFIG_MINIDASH_SIMULATION=y
CONFIG_MINIDASH_CAN_ENABLE=y
CONFIG_MINIDASH_CAN_TX_GPIO=22
CONFIG_MINIDASH_CAN_RX_GPIO=27
CONFIG_MINIDASH_STANDARD_OBD=y
CONFIG_MINIDASH_CAR_VALIDATION_MODE=y
CONFIG_TWAI_ISR_IN_IRAM=y
# CONFIG_MINIDASH_HOST_INJECTION is not set
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.cyd.csv"
# CONFIG_SPIRAM is not set
# CONFIG_BT_ENABLED is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_MINIDASH_DISPLAY_ENABLE=y
CONFIG_MINIDASH_LCD_CONTROLLER_ILI9341=y
CONFIG_MINIDASH_DISPLAY_ROTATION=1
CONFIG_MINIDASH_LCD_PIN_SCLK=14
CONFIG_MINIDASH_LCD_PIN_MOSI=13
CONFIG_MINIDASH_LCD_PIN_MISO=12
CONFIG_MINIDASH_LCD_PIN_CS=15
CONFIG_MINIDASH_LCD_PIN_DC=2
CONFIG_MINIDASH_LCD_PIN_RST=-1
CONFIG_MINIDASH_LCD_PIN_BL=21
CONFIG_MINIDASH_TOUCH_ENABLE=y
CONFIG_MINIDASH_TOUCH_PIN_CS=33
CONFIG_MINIDASH_TOUCH_SEPARATE_SPI=y
CONFIG_MINIDASH_TOUCH_PIN_SCLK=25
CONFIG_MINIDASH_TOUCH_PIN_MOSI=32
CONFIG_MINIDASH_TOUCH_PIN_MISO=39
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_QRCODE=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
