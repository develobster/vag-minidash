# INSTALLATION PRESET: wire SN65HVD230 TXD to GPIO4, RXD to GPIO5.
# These are provisioned pins, NOT a claim about an already assembled board.
CONFIG_MINIDASH_CAN_ENABLE=y
CONFIG_MINIDASH_CAN_TX_GPIO=4
CONFIG_MINIDASH_CAN_RX_GPIO=5
CONFIG_MINIDASH_STANDARD_OBD=y
# CONFIG_MINIDASH_HOST_INJECTION is not set
