menu "MiniDash display and UI"
    config MINIDASH_DISPLAY_ENABLE
        bool "Enable MiniDash SPI display and production UI"
        default n
        help
            Enable the display only after checking the module voltage and wiring.
            The normal build uses the LVGL UI and keeps vehicle acquisition external.

    choice MINIDASH_LCD_CONTROLLER
        prompt "SPI display controller"
        depends on MINIDASH_DISPLAY_ENABLE
        default MINIDASH_LCD_CONTROLLER_ST7789

    config MINIDASH_LCD_CONTROLLER_ILI9341
        bool "ILI9341"

    config MINIDASH_LCD_CONTROLLER_ST7789
        bool "ST7789"
    endchoice

    config MINIDASH_DISPLAY_SMOKE_TEST
        bool "Run RGB/black display smoke test on boot"
        depends on MINIDASH_DISPLAY_ENABLE
        default n

    config MINIDASH_DISPLAY_ROTATION
        int "Display rotation (controller-native orientation at 0)"
        range 0 3
        default 2

    config MINIDASH_LCD_X_GAP
        int "Display X RAM offset"
        range 0 320
        default 0
    config MINIDASH_LCD_Y_GAP
        int "Display Y RAM offset"
        range 0 320
        default 0
    config MINIDASH_LCD_INVERT
        bool "Invert display colors if required by the delivered module"
        default n

    config MINIDASH_LCD_PIN_SCLK
        int "SPI clock GPIO (-1 = unconfirmed)"
        range -1 48
        default -1
    config MINIDASH_LCD_PIN_MOSI
        int "SPI MOSI GPIO (-1 = unconfirmed)"
        range -1 48
        default -1
    config MINIDASH_LCD_PIN_MISO
        int "SPI MISO GPIO (-1 = not connected)"
        range -1 48
        default -1
    config MINIDASH_LCD_PIN_CS
        int "Display CS GPIO (-1 = unconfirmed)"
        range -1 48
        default -1
    config MINIDASH_LCD_PIN_DC
        int "Display DC GPIO (-1 = unconfirmed)"
        range -1 48
        default -1
    config MINIDASH_LCD_PIN_RST
        int "Display RESET GPIO (-1 = not connected)"
        range -1 48
        default -1
    config MINIDASH_LCD_PIN_BL
        int "Backlight switch GPIO (-1 = unavailable)"
        range -1 48
        default -1
    config MINIDASH_LCD_BL_ACTIVE_HIGH
        bool "Backlight GPIO active high"
        default y

    config MINIDASH_TOUCH_ENABLE
        bool "Enable XPT2046 resistive touch"
        depends on MINIDASH_DISPLAY_ENABLE
        default n
    config MINIDASH_TOUCH_PIN_CS
        int "XPT2046 chip select GPIO (-1 = disabled)"
        range -1 48
        depends on MINIDASH_TOUCH_ENABLE
        default -1
endmenu
