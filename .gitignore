# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
transport-venv/

# Local traces, driver reports and runtime secrets
*.jsonl
vnci-*.json
connection.json
captures/
traces/
artifacts/first-live/*
!artifacts/first-live/.gitkeep

# Build output
build/
/build-*/
/firmware/build*/
dist/
node_modules/
.minidash/
work/
test-results/
playwright-report/
*.egg-info/

# ESP-IDF generated local configuration
/firmware/sdkconfig
/firmware/sdkconfig.old
/firmware/managed_components/

# Local editor/OS files
.DS_Store
.idea/
.vscode/

core/build*/

# Local acceptance output, caches and packaging
.local/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
.pio/
*.log
*.tmp
*.bak
Thumbs.db
Desktop.ini

# Hardware backups and proprietary/private extraction output stay local.
# Do not use a global *.bin / *.json ignore: reviewed fixtures remain visible.
/artifacts/hardware/
/artifacts/odis-offline-audit/
/artifacts/local/
/firmware/*.bin
/firmware/*.elf
/firmware/*.map

# Synthetic, reviewed fixtures may use capture/log extensions.
!tests/fixtures/**/*.jsonl
!tests/fixtures/**/*.log
!tests/fixtures/**/*.bin

firmware/sdkconfig.*.generated
firmware/sdkconfig.*.generated.old
